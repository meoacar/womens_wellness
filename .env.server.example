# Production Environment Variables Template for Self-Hosted Server
# Copy this file to .env next to docker-compose.prod.yml (untracked on server)
# or pass via: docker compose --env-file /etc/wellness/.env -f docker-compose.prod.yml up -d
# NEVER commit real secrets to Git!

# Database
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32_DIFFERENT
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Admin & OAuth
ADMIN_EMAILS=admin@kadinatlasi.com
GOOGLE_OAUTH_AUDIENCES=

# AI Providers
GOOGLE_GENERATIVE_AI_API_KEY=CHANGE_ME_GEMINI_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# Payments & Store Webhooks (Apple / Google Play)
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.kadinatlasi.wellness
APPLE_ENVIRONMENT=Production
APPLE_ROOT_CA_CERTS=
APPLE_ROOT_CA_PEM=
APPLE_ROOT_CA_PATH=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PLAY_PACKAGE_NAME=com.kadinatlasi.wellness
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PUBSUB_PUSH_TOKEN=
SUBSCRIPTION_CURRENCY=TRY

# SMTP (Email delivery for password reset & notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM="Kadın Atlası <noreply@kadinatlasi.com>"
SMTP_TLS=false

# Internal Services
ASTROLOGY_SERVICE_URL=http://astrology:5000

# Monitoring & Alerting
SENTRY_DSN=
ALERT_WEBHOOK_URL=
ALERT_FAILURE_THRESHOLD=3
ALERT_COOLDOWN_MS=300000

# CORS (comma-separated allowed HTTPS origins)
CORS_ALLOWED_ORIGINS=https://kadinatlasi.com,https://www.kadinatlasi.com,https://admin.kadinatlasi.com

# Public URLs (NEXT_PUBLIC_* are also baked into Web/Admin images at build time)
APP_URL=https://kadinatlasi.com
API_BASE_URL=https://api.kadinatlasi.com
NEXT_PUBLIC_API_BASE_URL=https://api.kadinatlasi.com
NEXT_PUBLIC_SITE_URL=https://kadinatlasi.com
NEXT_PUBLIC_WEB_URL=https://kadinatlasi.com
PRODUCTION_URL=https://kadinatlasi.com
PRODUCTION_API_URL=https://api.kadinatlasi.com
