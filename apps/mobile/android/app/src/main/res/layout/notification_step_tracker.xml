<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/notif_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:paddingVertical="4dp">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/notif_steps_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="👟 0"
        android:textColor="@color/notif_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/notif_calories_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        android:text="🔥 0,0"
        android:textColor="@color/notif_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/notif_cycle_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/notif_cycle_pill_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp"
        android:text="🌸 Takvim"
        android:textColor="@color/notif_cycle_text"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
      android:id="@+id/notif_steps_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="5dp"
      android:layout_marginTop="7dp"
      android:max="100"
      android:progress="0"
      android:progressDrawable="@drawable/notif_progress_steps" />
  </LinearLayout>

  <TextView
    android:id="@+id/notif_open_steps_btn"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_marginStart="12dp"
    android:background="@drawable/notif_action_circle_bg"
    android:gravity="center"
    android:text="→"
    android:textColor="@color/notif_action_tint"
    android:textSize="16sp"
    android:textStyle="bold" />
</LinearLayout>
