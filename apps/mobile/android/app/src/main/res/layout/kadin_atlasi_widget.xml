<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_card_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <!-- Top Brand + Phase Pill Row -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:contentDescription="@string/app_name"
      android:src="@mipmap/ic_launcher" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="Kadın Atlası"
      android:textColor="#1F1630"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_phase_pill"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:background="@drawable/widget_pill_pink"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingHorizontal="8dp"
      android:paddingVertical="3dp"
      android:text="Döngü Takibi"
      android:textColor="#DB2777"
      android:textSize="11sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_updated_at"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="end"
      android:maxLines="1"
      android:text=""
      android:textColor="#8A7A95"
      android:textSize="10sp" />
  </LinearLayout>

  <!-- Headline & Subline -->
  <TextView
    android:id="@+id/widget_headline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Günlük özetin hazır"
    android:textColor="#1F1630"
    android:textSize="15sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_subline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Uygulamayı açarak verilerini senkronize et"
    android:textColor="#6B5E7A"
    android:textSize="11.5sp" />

  <!-- 3 Live Metric Tiles -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <!-- Cycle Tile -->
    <LinearLayout
      android:id="@+id/widget_tile_cycle"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:background="@drawable/widget_tile_bg"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingHorizontal="10dp"
      android:paddingVertical="8dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅 Döngü"
        android:textColor="#DB2777"
        android:textSize="10.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_cycle_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="-"
        android:textColor="#1F1630"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_cycle_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Takvimi aç"
        android:textColor="#7D6F8A"
        android:textSize="10sp" />
    </LinearLayout>

    <!-- Water Tile -->
    <LinearLayout
      android:id="@+id/widget_tile_water"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:background="@drawable/widget_tile_bg"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingHorizontal="10dp"
      android:paddingVertical="8dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💧 Su"
        android:textColor="#0284C7"
        android:textSize="10.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_water_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="0 ml"
        android:textColor="#1F1630"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_water_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="/ 2.000 ml"
        android:textColor="#7D6F8A"
        android:textSize="10sp" />
    </LinearLayout>

    <!-- Steps Tile -->
    <LinearLayout
      android:id="@+id/widget_tile_steps"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/widget_tile_bg"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:paddingHorizontal="10dp"
      android:paddingVertical="8dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👣 Adım"
        android:textColor="#059669"
        android:textSize="10.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_steps_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="0"
        android:textColor="#1F1630"
        android:textSize="14sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widget_steps_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="/ 7.000 adım"
        android:textColor="#7D6F8A"
        android:textSize="10sp" />
    </LinearLayout>
  </LinearLayout>

</LinearLayout>
